{
  "name": "felpautomations",
  "version": "0.1.0",
  "private": true,
  "description": "Central desktop de execução de fluxos Playwright",
  "main": "dist-electron/electron/main.js",
  "scripts": {
    "dev": "npm run build && electron .",
    "start": "electron .",
    "build": "tsc -p tsconfig.electron.json && tsc --noEmit -p tsconfig.json && vite build",
    "check": "tsc --noEmit -p tsconfig.electron.json && tsc --noEmit -p tsconfig.json",
    "browser:install": "playwright install chromium",
    "test": "npm run build && node --test tests/*.test.cjs",
    "test:desktop": "npm run build && node tests/desktop-smoke.cjs"
  },
  "dependencies": { "playwright": "latest" },
  "devDependencies": { "@types/node": "latest", "electron": "latest", "typescript": "latest", "vite": "latest" }
}
